{
  "expo": {
    "name": "PowerIQ-AI",
    "slug": "poweriq-live-alerts",
    "scheme": "poweriqalerts",
    "version": "1.2.0",

    "runtimeVersion": "1.0.8",

    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poweriq.livealerts",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "PowerIQ uses your location to verify if you are within 500m of the plant for alert siren sounds.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PowerIQ requires background location to detect when you enter or enter the 500m plant boundary so alert notification sounds can be muted when you are away from the plant."
      }
    },

    "android": {
      "package": "com.poweriq.livealerts",
      "versionCode": 22,
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/icon.png",

      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },

      "permissions": [
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },

    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PowerIQ uses your location to verify if you are within 500m of the plant for alert siren sounds.",
          "locationAlwaysAndWhenInUsePermission": "PowerIQ requires background location to detect when you enter or exit the 500m plant boundary so alert notification sounds can be muted when you are away from the plant.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PowerIQ requires photo library access to choose inverter display photos for OCR logging.",
          "cameraPermission": "PowerIQ requires camera access to capture inverter display slips for OCR logging."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB",
          "sounds": [
            "./assets/sounds/poweriq_alert.wav",
            "./assets/sounds/poweriq_critical.wav"
          ]
        }
      ],
      "expo-asset"
    ],

    "extra": {
      "eas": {
        "projectId": "b1506bc9-c624-4a4c-b876-e4d325453e29"
      }
    },

    "owner": "vaibhavimahure",

    "updates": {
      "url": "https://u.expo.dev/b1506bc9-c624-4a4c-b876-e4d325453e29",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    }
  }
}
